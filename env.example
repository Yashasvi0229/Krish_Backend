# ============================================================================
# GNC Invoice Automation — Backend Environment Variables
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file — it is in .gitignore.
# ============================================================================

# ---- App ----
APP_ENV=development                # development | staging | production
APP_NAME=GNC Invoice Automation
APP_VERSION=1.0.0
DEBUG=true                         # false in production
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR
TIMEZONE=America/Edmonton

# ---- Server ----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Database ----
# Async driver (used by FastAPI at runtime):
DATABASE_URL=postgresql+asyncpg://gnc:gnc_pass@localhost:5432/gnc_invoice
# Sync driver (used by Alembic migrations):
DATABASE_URL_SYNC=postgresql+psycopg2://gnc:gnc_pass@localhost:5432/gnc_invoice
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false                # log SQL queries (dev only)

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_DB=1

# ---- Celery ----
CELERY_BROKER_URL=redis://localhost:6379/2
CELERY_RESULT_BACKEND=redis://localhost:6379/3
CELERY_WORKER_CONCURRENCY=4
CELERY_TASK_TIME_LIMIT=600         # 10 min hard limit
CELERY_TASK_SOFT_TIME_LIMIT=540    # 9 min soft limit

# ---- Security ----
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-string-in-production
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
KEY_ENCRYPTION_KEY=change-me-to-a-fernet-key-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_HOURS=24

# ---- Admin credentials (Phase 1 single-admin login — Step 3) ----
# The one user who can log in. Rotate the password here to invalidate all sessions.
ADMIN_EMAIL=admin@gnc.local
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=Administrator

# ---- Google OAuth (Step 3) ----
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
GOOGLE_ALLOWED_DOMAIN=              # optional, e.g. gncgroup.ca — leave blank to allow any domain

# ---- AI providers (Step 5) ----
AI_DEFAULT_PROVIDER=claude         # claude | openai | gemini
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---- File Storage ----
STORAGE_ROOT=./storage             # relative for dev; /var/gnc-invoice-data in prod
MAX_ATTACHMENT_SIZE_MB=20

# ---- OCR (Step 4) ----
TESSERACT_CMD=/usr/bin/tesseract
TESSERACT_LANG=eng
OCR_TIMEOUT_SECONDS=60

# ---- Gmail (Step 4) ----
GMAIL_MAX_RESULTS_PER_SEARCH=500
GMAIL_BATCH_SIZE=50

# ---- Business rules ----
MAX_HOURS_PER_LINE_ITEM=3.9
SITE_VISIT_HOUR_CAP=4.0
DEFAULT_CURRENCY=CAD
DEFAULT_GST_PERCENT=0

# ---- Monitoring (optional) ----
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
